{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPCONFIG" },
        { "path": "$APPCONFIG/**" }
      ]
    },
    "sql:default",
    "sql:allow-execute"
  ]
}
